<?xml version="1.0" encoding="utf-8" ?>

<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
    x:Class="StudentProfileNavigator.MainPage" 
    Title="Student Information"> 

    <ScrollView> 

        <VerticalStackLayout 
            Padding="30" 
            Spacing="15"> 

            <Label 
                Text="STUDENT PROFILE" 
                FontSize="28" 
                FontAttributes="Bold" 
                HorizontalOptions="Center" /> 

            <Label 
                Text="Enter your information below." 
                FontSize="16" 
                HorizontalOptions="Center" /> 

            <Entry 
                x:Name="txtName" 
                Placeholder="Enter student name" 
                TextChanged="OnNameTextChanged" /> 

            <Label 
                x:Name="lblCharacterCount" 
                Text="Characters: 0" /> 

            <Entry 
                x:Name="txtStudentNumber" 
                Placeholder="Enter student number" /> 

            <Entry 
                x:Name="txtEmail" 
                Placeholder="Enter email address" 
                Keyboard="Email" /> 

            <Entry 
                x:Name="txtAge" 
                Placeholder="Enter age" 
                Keyboard="Numeric" /> 

            <Picker 
                x:Name="pickerGender" 
                Title="Select Gender"> 
                <Picker.Items> 
                    <x:String>Male</x:String> 
                    <x:String>Female</x:String> 
                    <x:String>Prefer not to say</x:String> 
                </Picker.Items> 
            </Picker> 

            <Picker 
                x:Name="pickerProgram" 
                Title="Select Program"> 
                <Picker.Items> 
                    <x:String>BS Information Technology</x:String> 
                    <x:String>BS Computer Science</x:String> 
                    <x:String>BS Computer Engineering</x:String> 
                    <x:String>BS Information Systems</x:String> 
                </Picker.Items> 
            </Picker> 

            <Button 
                Text="CONTINUE" 
                Clicked="OnContinueClicked" /> 

            <Button 
                Text="RESET" 
                Clicked="OnResetClicked" /> 

        </VerticalStackLayout> 

    </ScrollView> 

</ContentPage>

