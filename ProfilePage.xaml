<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
    x:Class="StudentProfileNavigator.ProfilePage" 
    Title="Student Profile"
    NavigationPage.BarBackgroundColor="#0B0F19"
    NavigationPage.BarTextColor="#FFFFFF"
    BackgroundColor="#0B0F19">

    <ScrollView>
        <VerticalStackLayout 
            Padding="24,30" 
            Spacing="20"
            MaximumWidthRequest="500"
            HorizontalOptions="Center">

            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Border 
                    BackgroundColor="#312E81" 
                    Stroke="#6366F1" 
                    StrokeShape="RoundRectangle 12" 
                    Padding="12,4" 
                    HorizontalOptions="Center">
                    <Label 
                        Text="✦ OFFICIAL UNIVERSITY ID" 
                        FontSize="11" 
                        FontAttributes="Bold" 
                        TextColor="#C7D2FE" 
                        CharacterSpacing="1" />
                </Border>

                <Border 
                    Stroke="#8B5CF6" 
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 36" 
                    BackgroundColor="#1E1B4B" 
                    WidthRequest="72" 
                    HeightRequest="72"
                    HorizontalOptions="Center">
                    <Label 
                        Text="🎓" 
                        FontSize="32" 
                        HorizontalOptions="Center" 
                        VerticalOptions="Center" />
                </Border>

                <Label 
                    Text="STUDENT PROFILE" 
                    FontSize="26" 
                    FontAttributes="Bold" 
                    TextColor="#FFFFFF" 
                    HorizontalOptions="Center" />

                <Label 
                    Text="Registered and Verified Profile" 
                    FontSize="13" 
                    TextColor="#94A3B8" 
                    HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Border 
                Stroke="#1E293B" 
                StrokeShape="RoundRectangle 20" 
                BackgroundColor="#111827" 
                Padding="22">
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,8" Radius="20" Opacity="0.4" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="14">

                    <VerticalStackLayout Spacing="4">
                        <Label 
                            Text="NAME" 
                            FontSize="11" 
                            FontAttributes="Bold" 
                            TextColor="#64748B" />
                        <Label 
                            x:Name="lblName" 
                            FontSize="20" 
                            FontAttributes="Bold" 
                            TextColor="#F8FAFC" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#1E293B" />

                    <VerticalStackLayout Spacing="4">
                        <Label 
                            Text="STUDENT NUMBER" 
                            FontSize="11" 
                            FontAttributes="Bold" 
                            TextColor="#64748B" />
                        <Label 
                            x:Name="lblStudentNumber" 
                            FontSize="17" 
                            FontAttributes="Bold" 
                            TextColor="#38BDF8" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#1E293B" />

                    <VerticalStackLayout Spacing="4">
                        <Label 
                            Text="EMAIL ADDRESS" 
                            FontSize="11" 
                            FontAttributes="Bold" 
                            TextColor="#64748B" />
                        <Label 
                            x:Name="lblEmail" 
                            FontSize="16" 
                            TextColor="#C084FC" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#1E293B" />

                    <Grid ColumnDefinitions="*,*">
                        <VerticalStackLayout Spacing="4">
                            <Label 
                                Text="AGE" 
                                FontSize="11" 
                                FontAttributes="Bold" 
                                TextColor="#64748B" />
                            <Label 
                                x:Name="lblAge" 
                                FontSize="16" 
                                TextColor="#F8FAFC" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label 
                                Text="GENDER" 
                                FontSize="11" 
                                FontAttributes="Bold" 
                                TextColor="#64748B" />
                            <Label 
                                x:Name="lblGender" 
                                FontSize="16" 
                                TextColor="#F8FAFC" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#1E293B" />

                    <VerticalStackLayout Spacing="4">
                        <Label 
                            Text="PROGRAM" 
                            FontSize="11" 
                            FontAttributes="Bold" 
                            TextColor="#64748B" />
                        <Label 
                            x:Name="lblProgram" 
                            FontSize="17" 
                            FontAttributes="Bold" 
                            TextColor="#34D399" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <Button 
                Text="←  BACK" 
                Clicked="OnBackClicked"
                BackgroundColor="#1E293B"
                BorderColor="#334155"
                BorderWidth="1"
                TextColor="#E2E8F0"
                FontAttributes="Bold"
                FontSize="15"
                CornerRadius="14"
                HeightRequest="50" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
